extends RefCounted
## An original 5x7 bitmap alphabet. HUD text stays on the same pixel grid as the world.
const GLYPHS := {
	"A": [14,17,17,31,17,17,17], "B": [30,17,17,30,17,17,30], "C": [14,17,16,16,16,17,14],
	"D": [30,17,17,17,17,17,30], "E": [31,16,16,30,16,16,31], "F": [31,16,16,30,16,16,16],
	"G": [14,17,16,23,17,17,15], "H": [17,17,17,31,17,17,17], "I": [31,4,4,4,4,4,31],
	"J": [7,2,2,2,18,18,12], "K": [17,18,20,24,20,18,17], "L": [16,16,16,16,16,16,31],
	"M": [17,27,21,21,17,17,17], "N": [17,25,21,19,17,17,17], "O": [14,17,17,17,17,17,14],
	"P": [30,17,17,30,16,16,16], "Q": [14,17,17,17,21,18,13], "R": [30,17,17,30,20,18,17],
	"S": [15,16,16,14,1,1,30], "T": [31,4,4,4,4,4,4], "U": [17,17,17,17,17,17,14],
	"V": [17,17,17,17,17,10,4], "W": [17,17,17,21,21,21,10], "X": [17,17,10,4,10,17,17],
	"Y": [17,17,10,4,4,4,4], "Z": [31,1,2,4,8,16,31],
	"0": [14,17,19,21,25,17,14], "1": [4,12,4,4,4,4,14], "2": [14,17,1,2,4,8,31],
	"3": [30,1,1,14,1,1,30], "4": [2,6,10,18,31,2,2], "5": [31,16,16,30,1,1,30],
	"6": [14,16,16,30,17,17,14], "7": [31,1,2,4,8,8,8], "8": [14,17,17,14,17,17,14],
	"9": [14,17,17,15,1,1,14], ":": [0,4,4,0,4,4,0], "/": [1,1,2,4,8,16,16],
	"-": [0,0,0,31,0,0,0], ".": [0,0,0,0,0,6,6], "+": [0,4,4,31,4,4,0],
	"[": [14,8,8,8,8,8,14], "]": [14,2,2,2,2,2,14], "!": [4,4,4,4,4,0,4],
	">": [16,8,4,2,4,8,16], "<": [1,2,4,8,4,2,1], "=": [0,0,31,0,31,0,0],
}

static func write(canvas: CanvasItem, value: String, at: Vector2, color: Color, scale: int = 1) -> void:
	var x := int(at.x)
	for letter in value.to_upper():
		if GLYPHS.has(letter):
			var glyph: Array = GLYPHS[letter]
			for row in range(7):
				for column in range(5):
					if int(glyph[row]) & (1 << (4 - column)):
						canvas.draw_rect(Rect2(x + column * scale, at.y + row * scale, scale, scale), color)
		x += 6 * scale

static func centered(canvas: CanvasItem, value: String, at: Vector2, color: Color, scale: int = 1) -> void:
	write(canvas, value, at - Vector2((value.length() * 6 - 1) * scale / 2.0, 0), color, scale)
